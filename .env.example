# Bayora AI Safety Testing Platform Environment Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Target LLM Configuration
# Options: ollama (default for local CPU/demo) | openai (hosted API) | mock (offline fallback)
TARGET_LLM_PROVIDER=ollama
TARGET_LLM_ENDPOINT=http://target:11434
TARGET_LLM_MODEL=qwen2.5:3b
TARGET_LLM_API_KEY=

# Gateway Secret & HMAC Key (auto-generated if empty)
BAYORA_TOKEN_SECRET=replace_with_strong_random_secret_or_leave_empty_for_auto
BAYORA_ADMIN_KEY=sk_bayora_admin_local_dev

# Optional: LLM Judge Configuration
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-4o-mini